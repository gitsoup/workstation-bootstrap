#!/bin/zsh
# Directory-based GitHub CLI account selection. Not a security boundary.
set -eu
ROOT="$HOME/repos"
case "$PWD/" in
  "$ROOT/personal/"*) export GH_CONFIG_DIR="$HOME/.config/gh-personal" ;;
  "$ROOT/work/"*)     export GH_CONFIG_DIR="$HOME/.config/gh-work" ;;
  *) print -u2 'ERROR: GitHub account not selected. Run gh under ~/repos/personal or ~/repos/work.'; exit 2 ;;
esac
exec /opt/homebrew/bin/gh "$@"
